# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments and packages
.venv
.qmd
node_modules

# Caches and docs
.cache/

# kp-docs holds large source PDFs/exports we don't want in git; only the
# markdown/ subdir (used by the review notebook) is tracked.
kp-docs/*
!kp-docs/markdown/

# Review output (ephemeral, per-session reviewer annotations)
review-output/

# Agent working notes (not part of the public project)
.agents/

